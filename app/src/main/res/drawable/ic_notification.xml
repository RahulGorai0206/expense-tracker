<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon. Android keeps only the alpha channel here, so this is the
  mark in one flat white with no gradient.

  Scaled up about the centre because there is no adaptive-icon mask to keep
  clear of, and the mark needs every pixel at 24dp. It survives that size
  because it is two solid shapes with a gap between them rather than anything
  that depends on stroke weight.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.30"
        android:scaleY="1.30">

        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M74.63,44.00 A24.5,24.5 0 1,1 52.14,31.01 L52.60,43.91 A11.6,11.6 0 1,0 63.24,50.05 Z" />

        <group
            android:translateX="5.0"
            android:translateY="-8.66">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M52.14,31.01 A24.5,24.5 0 0,1 74.63,44.00 L63.24,50.05 A11.6,11.6 0 0,0 52.60,43.91 Z" />
        </group>
    </group>
</vector>

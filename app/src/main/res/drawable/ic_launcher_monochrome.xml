<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer for Android 13+ themed icons. The launcher discards colour
  and tints the alpha channel, so ring and slice arrive as one value.

  The mark survives that because the slice is separated from the ring by real
  negative space — the gap it was displaced out of — rather than by a colour
  difference. This is the reason the slice is pushed along its own bisector: a
  displacement in any other direction leaves the two shapes overlapping on one
  side, and in flat colour they would fuse into a blob.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FF000000"
        android:pathData="M74.63,44.00 A24.5,24.5 0 1,1 52.14,31.01 L52.60,43.91 A11.6,11.6 0 1,0 63.24,50.05 Z" />

    <group
        android:translateX="5.0"
        android:translateY="-8.66">
        <path
            android:fillColor="#FF000000"
            android:pathData="M52.14,31.01 A24.5,24.5 0 0,1 74.63,44.00 L63.24,50.05 A11.6,11.6 0 0,0 52.60,43.91 Z" />
    </group>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: a ring of money with one slice pulled out of it.

  The ring is the balance; the displaced wedge is what just left. That reads
  without explanation, which is the test the previous icon failed — a message
  bubble with an arrow in it was a clever sentence about how the app works and
  a meaningless shape at 48dp.

  Deliberately not a wallet, a coin, a currency sign or a bar chart. Those are
  what the whole category draws and they are interchangeable at icon size.

  ## Why each piece is one explicit path

  The obvious construction is even-odd: an outer circle, an inner circle to
  punch the hole, and a wedge to cut the gap. That is wrong, and silently so.
  Even-odd fills anything covered an odd number of times, so the part of the
  wedge lying inside the centre hole is covered three times and comes back
  filled — a stray triangle in the middle of the ring.

  Both shapes are therefore authored as closed annular sectors instead: the
  ring is the 296 degrees that remain, the slice is the 64 degrees that left.
  No fill rule, nothing to get wrong.

  Geometry: centre (53,55.5), outer radius 24.5, inner 11.6; the slice spans
  -92 to -28 degrees and is displaced 10 along its own bisector, so it travels
  straight out of the gap it came from. The furthest point of the artwork sits
  32.7 from the icon centre, just inside the 33 the mask guarantees.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The balance. -->
    <path android:pathData="M74.63,44.00 A24.5,24.5 0 1,1 52.14,31.01 L52.60,43.91 A11.6,11.6 0 1,0 63.24,50.05 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="30"
                android:endX="80"
                android:endY="82">
                <item android:color="#FF8FF3E2" android:offset="0.0" />
                <item android:color="#FF4FCFC4" android:offset="0.55" />
                <item android:color="#FF3D8BFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!--
      What left. Flat and brighter than the ring rather than continuing its
      gradient: the slice has to read as a separate object that has moved, and
      a gradient running continuously through both would glue them back
      together.
    -->
    <group
        android:translateX="5.0"
        android:translateY="-8.66">
        <path
            android:fillColor="#FFA9FBE8"
            android:pathData="M52.14,31.01 A24.5,24.5 0 0,1 74.63,44.00 L63.24,50.05 A11.6,11.6 0 0,0 52.60,43.91 Z" />
    </group>
</vector>

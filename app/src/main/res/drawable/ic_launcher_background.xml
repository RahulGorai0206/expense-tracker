<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background. Full-bleed 108dp so every launcher mask (circle,
  squircle, rounded square) has paint under it.

  Near-black, tinted towards the app's own blue, with the mint secondary
  appearing as a spill rather than as a field of colour. The ring is the money;
  the ground is the dark it sits on, and the spill is what keeps the mark from
  looking like a flat sticker at small sizes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="4"
                android:startY="0"
                android:endX="104"
                android:endY="108">
                <item android:color="#FF141C28" android:offset="0.0" />
                <item android:color="#FF0B0D10" android:offset="0.55" />
                <item android:color="#FF090B0E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Centred on the gap the slice left, which is where the eye goes. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="56"
                android:centerY="44"
                android:gradientRadius="50">
                <item android:color="#5790F7E0" android:offset="0.0" />
                <item android:color="#2690F7E0" android:offset="0.45" />
                <item android:color="#0090F7E0" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
